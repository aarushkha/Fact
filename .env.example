# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# true = every adapter is a deterministic mock; no API keys or models needed.
MOCK_MODE=true
LOG_LEVEL=INFO
# Timezone used to interpret post dates that carry no offset (e.g. "2026-10-01").
TIMEZONE=Asia/Kolkata

# Source whitelist (ignored in MOCK_MODE, which uses app/adapters/mock_data/sources.yaml)
SOURCES_FILE=sources.yaml

# ---------------------------------------------------------------------------
# Storage / search
# ---------------------------------------------------------------------------
# Empty -> in-memory store and the built-in mock corpus (mock mode only).
# docker compose sets this for the app container automatically.
# For a local (non-docker) app talking to the compose database:
#   DATABASE_URL=postgresql+asyncpg://fact:fact@localhost:5432/fact
DATABASE_URL=
# auto | mock | postgres   (auto = postgres when DATABASE_URL is set)
SEARCH_BACKEND=auto
SEARCH_MIN_VECTOR_SIMILARITY=0.5
SEARCH_RRF_K=60

# ---------------------------------------------------------------------------
# Crawler
# ---------------------------------------------------------------------------
CRAWLER_USER_AGENT=FactCrawler/0.1 (+contact: TODO)
CRAWLER_MAX_ARTICLES_PER_SOURCE=50
CRAWLER_CONCURRENCY=4
# Minimum seconds between two requests to the same host; a robots.txt Crawl-delay (capped at 60 s) raises it.
CRAWLER_MIN_HOST_INTERVAL_SECONDS=1.0
CHUNK_MAX_WORDS=180

# ---------------------------------------------------------------------------
# Providers (used only when MOCK_MODE=false)
# ---------------------------------------------------------------------------
# Gemini (LLM + vision). Free tier is very limited (gemini-3.8-flash: 5 req/min, 20 req/day);
# overloaded or rate-limited models are skipped for a while and the next fallback is used.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
LLM_THINKING_LEVEL=low
# Keep Gemini use low while testing: sentence splitting instead of LLM claim extraction, and
# verbatim evidence quotes instead of LLM-written summaries. Set to llm / llm for higher quality.
CLAIM_EXTRACTOR=sentences
SUMMARY_WRITER=extractive
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# sarvam | llm
TRANSLATOR_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_TRANSLATE_MODEL=mayura:v1

# jev (via OpenRouter; falls back to the LLM judge on errors) | llm
CLASSIFIER_PROVIDER=jev
OPENROUTER_API_KEY=
JEV_MODEL_VERSION=typesafe/jev-1.13

# Self-hosted, run in-process (pip install -e '.[models]'); pinned to Hugging Face commits
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIM=1024
EMBEDDER_MAX_SEQ_LENGTH=1024
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_REVISION=b5113eb38ab63efdd7f280f8c144ea8b13f978ce
# Optional: run embedder + NLI as a separate service (docker compose --profile models up).
# MODEL_SERVER_URL=http://models:8001   (http://localhost:8001 outside docker)
MODEL_SERVER_URL=
# With a token, a public MODEL_SERVER_URL must use https:// (http only to internal hosts such as http://models:8001).
MODEL_SERVER_TOKEN=

GOOGLE_FACTCHECK_API_KEY=
# Optional paid web-search fallback: not implemented yet (no provider chosen); must stay false.
WEB_SEARCH_ENABLED=false
HTTP_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# API protection
# ---------------------------------------------------------------------------
# Comma-separated keys sent as the X-API-Key header. Empty = no auth (local testing only).
API_KEYS=
# Guards the /settings page (X-Admin-Token). Empty = an API key opens it instead, or anyone when API_KEYS is empty.
# When set here, the settings page cannot change it (so you can always get back in).
ADMIN_TOKEN=
# Without a database, where /settings keeps its changes across restarts (empty = memory only). With a database
# (docker compose) they are stored in the settings_overrides table and need no file.
SETTINGS_OVERRIDES_FILE=
# Checks per minute per API key (or per IP when API_KEYS is empty). 0 = unlimited.
RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Thresholds (untuned defaults; tune with the eval harness)
# ---------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.6
CLAIM_TYPE_THRESHOLD=0.6
PASSAGE_RELEVANCE_THRESHOLD=0.5
SAME_EVENT_THRESHOLD=0.6
CACHE_SIMILARITY_THRESHOLD=0.92
FACTCHECK_SIMILARITY_THRESHOLD=0.85
FACTCHECK_HIT_CONFIDENCE=0.9
NLI_ENTAILMENT_THRESHOLD=0.5
# Summary sentences entailing a CONTRADICTED / MISLEADING_CONTEXT claim this strongly are dropped (restatements).
NLI_RESTATEMENT_THRESHOLD=0.8
# english = verified English summaries; post = also translated into the post's language and re-verified by NLI (untuned).
SUMMARY_LANGUAGE=english
TOO_EARLY_WINDOW_HOURS=72
RECHECK_TOO_EARLY_HOURS=6
RECHECK_EVIDENCE_MISSING_DAYS=7
# Worker (python -m app.worker / compose service "worker")
RECHECK_MAX_AGE_DAYS=30
RECHECK_INTERVAL_MINUTES=15
RECHECK_BATCH_SIZE=20
CRAWL_INTERVAL_MINUTES=60
RETRIEVAL_TOP_K=8
MAX_UPLOAD_MB=10
