# ===========================================================================
# HOW TO USE THIS FILE
#   cp .env.example .env      (.env is gitignored: never commit it, never paste keys into chat or code)
#
# Do you need keys at all?
#   MOCK_MODE=true  -> NO. Everything runs on mocks and a fictional corpus. Leave all *_API_KEY empty.
#   MOCK_MODE=false -> YES: the four keys below, plus the self-hosted models and Postgres (DATABASE_URL).
#
# The four keys (all four are needed for real mode). Each section below says what it is for,
# where to get it and how to check it. Quick map:
#
#   GEMINI_API_KEY            Google AI Studio    reads screenshots; LLM fallback        (free tier, tiny quota)
#   SARVAM_API_KEY            Sarvam AI           language detection + translation      (header api-subscription-key)
#   OPENROUTER_API_KEY        OpenRouter          Jev classifier (typesafe/jev-1.13)     (Bearer token, "sk-or-v1-...")
#   GOOGLE_FACTCHECK_API_KEY  Google Cloud        Fact Check Tools claims:search         (header x-goog-api-key)
#
# Ask the repo owner for the real values. They are not in git. If a key is missing the app fails at
# startup with a message naming it (e.g. "GEMINI_API_KEY is not set"), or the real-mode tests skip.
# ===========================================================================

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# true = every adapter is a deterministic mock; no API keys or models needed.
MOCK_MODE=true
LOG_LEVEL=INFO
# Timezone used to interpret post dates that carry no offset (e.g. "2026-10-01").
TIMEZONE=Asia/Kolkata

# Source whitelist (ignored in MOCK_MODE, which uses app/adapters/mock_data/sources.yaml)
SOURCES_FILE=sources.yaml

# ---------------------------------------------------------------------------
# Storage / search
# ---------------------------------------------------------------------------
# Empty -> in-memory store and the built-in mock corpus (mock mode only).
# docker compose sets this for the app container automatically.
# For a local (non-docker) app talking to the compose database:
#   DATABASE_URL=postgresql+asyncpg://fact:fact@localhost:5432/fact
DATABASE_URL=
# auto | mock | postgres   (auto = postgres when DATABASE_URL is set)
SEARCH_BACKEND=auto
SEARCH_MIN_VECTOR_SIMILARITY=0.5
SEARCH_RRF_K=60

# ---------------------------------------------------------------------------
# Crawler
# ---------------------------------------------------------------------------
CRAWLER_USER_AGENT=FactCrawler/0.1 (+contact: TODO)
CRAWLER_MAX_ARTICLES_PER_SOURCE=50
CRAWLER_CONCURRENCY=4
CHUNK_MAX_WORDS=180

# ---------------------------------------------------------------------------
# Providers (used only when MOCK_MODE=false)
# ---------------------------------------------------------------------------
# --- GEMINI_API_KEY ---------------------------------------------------------
# What: Google Gemini, used for (1) reading screenshots (always) and (2) fallbacks / optional LLM
#       claim extraction and summaries. With CLAIM_EXTRACTOR=sentences and SUMMARY_WRITER=extractive
#       (the defaults) a TEXT check makes no Gemini calls.
# Get it: https://aistudio.google.com/apikey  (a plain AI Studio key; the Interactions API is used:
#       POST https://generativelanguage.googleapis.com/v1beta/interactions, header x-goog-api-key).
# Limits: free tier is tiny. gemini-3.8-flash = 5 requests/minute and 20/day, and it is often
#       overloaded (HTTP 503). Overloaded or rate-limited models are skipped for a while and the next
#       one in LLM_FALLBACK_MODELS is used. The model that actually answered is logged per stage.
# Check:  RUN_LIVE_TESTS=1 pytest tests/test_live.py -k gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
LLM_THINKING_LEVEL=low
# Keep Gemini use low while testing: sentence splitting instead of LLM claim extraction, and
# verbatim evidence quotes instead of LLM-written summaries. Set to llm / llm for higher quality.
CLAIM_EXTRACTOR=sentences
SUMMARY_WRITER=extractive
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# --- SARVAM_API_KEY ---------------------------------------------------------
# What: Sarvam AI. /text-lid detects the language (Hinglish comes back as hi-IN + script Latn, which
#       we call "hi-Latn") and /translate (mayura:v1) produces the English text used for search and judging.
# Get it: https://dashboard.sarvam.ai  (sent as the header api-subscription-key, NOT a Bearer token).
# Notes: input limit 1000 characters per call (we split by sentence); source "auto" works only with
#       mayura:v1. An invalid key returns HTTP 403 invalid_api_key_error.
# Check:  RUN_LIVE_TESTS=1 pytest tests/test_live.py -k sarvam
# TRANSLATOR_PROVIDER: sarvam | llm  (llm = Gemini translates; uses the Gemini quota)
TRANSLATOR_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_TRANSLATE_MODEL=mayura:v1

# --- OPENROUTER_API_KEY -----------------------------------------------------
# What: the Jev classifier (TypeSafe) is called THROUGH OpenRouter, so the key is an OpenRouter key
#       (starts with "sk-or-v1-"), not a TypeSafe key. Jev judges claim type, passage stance, "is this
#       passage about the same incident?", expected evidence and the claim-level verdict.
# Get it: https://openrouter.ai/keys  (sent as Authorization: Bearer <key>).
# Endpoint: POST https://openrouter.ai/api/alpha/decisions  (Decisions API; ~0.2 s per call, billed per
#       input token, output is free).
# JEV_MODEL_VERSION: pinned on purpose. NEVER use "~typesafe/jev-latest" (the app refuses it): a silent
#       model change would change every verdict. Bump it deliberately and re-run the eval.
# CLASSIFIER_PROVIDER: jev = Jev, falling back to a Gemini JSON judge if Jev errors | llm = Gemini only.
# Check:  RUN_LIVE_TESTS=1 pytest tests/test_live.py -k jev
CLASSIFIER_PROVIDER=jev
OPENROUTER_API_KEY=
JEV_MODEL_VERSION=typesafe/jev-1.13

# --- Self-hosted models: NO key needed ---------------------------------------
# BGE-M3 (embeddings) and mDeBERTa (NLI) are public Hugging Face models run on your machine.
# Install: pip install --index-url https://download.pytorch.org/whl/cpu torch && pip install -e '.[models]'
# About 3 GB of weights download on first use. HF_TOKEN is optional (only removes a rate-limit warning).
# Check:  RUN_MODEL_TESTS=1 pytest tests/test_live.py -k local
# Pinned to Hugging Face commits so results are reproducible.
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIM=1024
EMBEDDER_MAX_SEQ_LENGTH=1024
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_REVISION=b5113eb38ab63efdd7f280f8c144ea8b13f978ce
# Optional: run embedder + NLI as a separate service (docker compose --profile models up).
# MODEL_SERVER_URL=http://models:8001   (http://localhost:8001 outside docker)
MODEL_SERVER_URL=
MODEL_SERVER_TOKEN=

# --- GOOGLE_FACTCHECK_API_KEY -----------------------------------------------
# What: Google Fact Check Tools API (claims:search). Used to (1) short-circuit a claim that a
#       whitelisted fact-checker already rated and (2) add reviews as evidence. It is also how the 200-row
#       real eval set is built (python -m eval.build_factcheck_set).
# Get it: Google Cloud console -> enable "Fact Check Tools API" -> Credentials -> API key
#       (https://developers.google.com/fact-check/tools/api). Sent as the header x-goog-api-key.
#       Never put it in a URL (it would leak into logs).
# Notes: returns {} when nothing matches. Reviews from publishers that are not in sources.yaml are ignored.
# Check:  RUN_LIVE_TESTS=1 pytest tests/test_live.py -k factcheck
GOOGLE_FACTCHECK_API_KEY=
# Optional paid web-search fallback: not implemented yet (no provider chosen); must stay false.
WEB_SEARCH_ENABLED=false
HTTP_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# API protection
# ---------------------------------------------------------------------------
# These are keys YOU invent to protect this API (not provider keys). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Comma-separated, sent by clients as the X-API-Key header (the test page has a field for it).
# Empty = no auth (local testing only). Protects /api/check*, /api/checks/* and /api/monitoring.
API_KEYS=
# Checks per minute per API key (or per IP when API_KEYS is empty). 0 = unlimited.
RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Thresholds (untuned defaults; tune with the eval harness)
# ---------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.6
CLAIM_TYPE_THRESHOLD=0.6
PASSAGE_RELEVANCE_THRESHOLD=0.5
SAME_EVENT_THRESHOLD=0.6
CACHE_SIMILARITY_THRESHOLD=0.92
FACTCHECK_SIMILARITY_THRESHOLD=0.85
FACTCHECK_HIT_CONFIDENCE=0.9
NLI_ENTAILMENT_THRESHOLD=0.5
# Summary sentences entailing a CONTRADICTED / MISLEADING_CONTEXT claim this strongly are dropped (restatements).
NLI_RESTATEMENT_THRESHOLD=0.8
TOO_EARLY_WINDOW_HOURS=72
RECHECK_TOO_EARLY_HOURS=6
RECHECK_EVIDENCE_MISSING_DAYS=7
# Worker (python -m app.worker / compose service "worker")
RECHECK_MAX_AGE_DAYS=30
RECHECK_INTERVAL_MINUTES=15
RECHECK_BATCH_SIZE=20
CRAWL_INTERVAL_MINUTES=60
RETRIEVAL_TOP_K=8
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Running with real keys: the shortest path
# ---------------------------------------------------------------------------
#   1. cp .env.example .env, fill the four keys, set MOCK_MODE=false
#   2. docker compose up -d db   and   DATABASE_URL=postgresql+asyncpg://fact:fact@localhost:5432/fact
#   3. pip install -e '.[models]'  (see "Self-hosted models" above)
#   4. python -m crawler.run --limit 20          # fill the evidence index from sources.yaml
#      (or, to try real models on the fictional demo corpus first:
#       SOURCES_FILE=app/adapters/mock_data/sources.yaml  and  python -m app.db.seed)
#   5. uvicorn app.main:app --reload             # http://localhost:8000/
#   6. RUN_LIVE_TESTS=1 pytest tests/test_live.py    # verifies all four keys
#
# Security: treat every key as secret. If one is ever pasted somewhere public (chat, issue, log),
# rotate it at the provider immediately. CI and the test suite never need real keys.
